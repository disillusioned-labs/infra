          "expr": "sum(rate(ocr_documents_processed_total{service_name=\"ocr\", status=\"needs_review\"}[5m])) / clamp_min(sum(rate(ocr_documents_processed_total{service_name=\"ocr\"}[5m])), 0.000001)",
          "refId": "A"
        }
