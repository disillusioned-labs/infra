  "panels": [
    {
      "type": "row",
      "title": "Proses & provider",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100
    },
    {
      "type": "timeseries",
      "title": "Liveness per proses (api/worker/outbox)",
      "description": "Push telemetry tidak punya `up`: seri ini konstan 1 selama proses hidup. Celah = proses mati; alert `absent()` per ocr_process.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (ocr_process) (ocr_process_running{service_name=\"ocr\"})",
          "legendFormat": "{{ocr_process}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Error provider: transient (retry SAQ) vs permanent",
      "description": "Transient = umumnya quota/rate limit Baidu (429) - job di-retry SAQ; permanent = config/token rusak - alarm.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 11,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "rate(ocr_pipeline_transient_errors_total{service_name=\"ocr\"}[5m])", "legendFormat": "transient (job retry)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (outcome) (rate(ocr_provider_errors_total{service_name=\"ocr\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "gRPC RED (Kontrak B handlers)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101
    },
    {
      "type": "timeseries",
      "title": "Request rate per method & status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (rpc_method, rpc_grpc_status) (rate(ocr_rpc_requests_total{service_name=\"ocr\"}[5m]))",
          "legendFormat": "{{rpc_method}} {{rpc_grpc_status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Handler latency p50/p95/p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 2,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(ocr_rpc_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(ocr_rpc_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(ocr_rpc_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Pipeline dokumen",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102
    },
    {
      "type": "timeseries",
      "title": "Dokumen selesai per status",
      "description": "Rate dokumen mencapai status terminal. needs_review tinggi = threshold/akurasi; failed = error pembacaan atau file.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (status) (rate(ocr_documents_processed_total{service_name=\"ocr\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Alasan kegagalan (per error code)",
      "description": "UNSUPPORTED_FILE_TYPE/RESOURCE_LIMIT/STORAGE_OBJECT_MISSING = permintaan ulang file; INTERNAL = alarm engine.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (error_code) (rate(ocr_documents_failed_total{service_name=\"ocr\"}[5m]))",
          "legendFormat": "{{error_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Pipeline duration p50/p95/p99 per provider",
      "description": "Download -> OCR -> ekstraksi untuk satu dokumen. Provider dipilih config (baidu_aistudio | paddleocr_local | digitalborn).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 5,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.50, sum by (le, ocr_provider) (rate(ocr_pipeline_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p50 {{ocr_provider}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.95, sum by (le, ocr_provider) (rate(ocr_pipeline_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p95 {{ocr_provider}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.99, sum by (le, ocr_provider) (rate(ocr_pipeline_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p99 {{ocr_provider}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Field extraction rate per field (status=extracted)",
      "description": "Kualitas per field skema (merchant/date/total/...): rasio dokumen yang field-nya 'extracted'. 'total' rendah = draft tidak lahir - kriteria pilot inti.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 12,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (field) (rate(ocr_document_fields_total{service_name=\"ocr\", status=\"extracted\"}[5m])) / clamp_min(sum by (field) (rate(ocr_document_fields_total{service_name=\"ocr\"}[5m])), 0.000001)",
          "legendFormat": "{{field}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "OCR stage latency p50/p95 per provider",
      "description": "Khusus panggilan provider OCR (semaphore + Baidu) - bukan seluruh pipeline. Kriteria pilot: < 15 detik per nota.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 13,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.50, sum by (le, ocr_provider) (rate(ocr_provider_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p50 {{ocr_provider}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.95, sum by (le, ocr_provider) (rate(ocr_provider_duration_seconds_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p95 {{ocr_provider}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
