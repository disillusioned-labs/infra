      "targets": [
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(ocr_document_size_bytes_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(ocr_document_size_bytes_bucket{service_name=\"ocr\"}[5m])))", "legendFormat": "p95", "refId": "B" }
