      "id": 20,
      "description": "Detik sejak sampel telemetri terakhir. Push-based: segar = proses hidup; merah > 90s (3x interval export).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "time() - timestamp(go_goroutine_count{service_name=\"identity\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
