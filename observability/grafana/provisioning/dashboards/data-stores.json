{
  "annotations": { "list": [] },
  "description": "Essential availability and capacity signals for PostgreSQL and Redis.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "link",
      "title": "Platform Overview",
      "icon": "external link",
      "url": "/d/exp-overview"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "**Data Stores - PostgreSQL & Redis**\n\nExporter status shows whether metrics can be collected; target status shows whether the database itself is reachable. The charts focus on connection and memory capacity."
      }
    },
    {
      "type": "stat",
      "title": "PostgreSQL exporter",
      "description": "The collector can scrape postgres_exporter.",
      "id": 2,
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"postgres-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "PostgreSQL target",
      "description": "The exporter can connect to PostgreSQL.",
      "id": 3,
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "pg_up{job=\"postgres-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Redis exporter",
      "description": "The collector can scrape redis_exporter.",
      "id": 4,
      "gridPos": { "x": 12, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"redis-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Redis target",
      "description": "The exporter can connect to Redis.",
      "id": 5,
      "gridPos": { "x": 18, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "redis_up{job=\"redis-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "row",
      "title": "PostgreSQL",
      "id": 10,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Connection usage",
      "description": "Current client connections as a percentage of max_connections.",
      "id": 11,
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "100 * sum(pg_stat_activity_count{job=\"postgres-exporter\"}) / clamp_min(max(pg_settings_max_connections{job=\"postgres-exporter\"}), 1)", "legendFormat": "connections used" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Redis",
      "id": 20,
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Redis memory in use. The maxmemory line appears only when Redis has an explicit memory limit configured.",
      "id": 21,
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes{job=\"redis-exporter\"}", "legendFormat": "used" },
        { "refId": "B", "expr": "redis_memory_max_bytes{job=\"redis-exporter\"} > 0", "legendFormat": "maxmemory limit" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Client connections",
      "description": "Connected Redis clients as a percentage of maxclients.",
      "id": 22,
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "100 * redis_connected_clients{job=\"redis-exporter\"} / clamp_min(redis_max_clients{job=\"redis-exporter\"}, 1)", "legendFormat": "clients used" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["infrastructure", "postgresql", "redis"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Data Stores - PostgreSQL & Redis",
  "uid": "data-stores",
  "version": 2
}
