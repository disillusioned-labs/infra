{
  "annotations": { "list": [] },
  "description": "Essential health, connection, memory, lag, and storage signals for PostgreSQL, Redis, and Kafka.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "link",
      "title": "Platform Overview",
      "icon": "external link",
      "url": "/d/exp-overview"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "**Data Stores & Messaging**\n\nExporter status shows whether metrics can be collected; target status shows whether the service itself is reachable. PostgreSQL memory is measured at the container level. Kafka storage availability uses the host root filesystem, which should contain the Kafka volume under the default rootful Podman layout."
      }
    },
    {
      "type": "stat",
      "title": "PostgreSQL exporter",
      "description": "The collector can scrape postgres_exporter.",
      "id": 2,
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"postgres-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "PostgreSQL target",
      "description": "The exporter can connect to PostgreSQL.",
      "id": 3,
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "pg_up{job=\"postgres-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Redis exporter",
      "description": "The collector can scrape redis_exporter.",
      "id": 4,
      "gridPos": { "x": 12, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"redis-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Redis target",
      "description": "The exporter can connect to Redis.",
      "id": 5,
      "gridPos": { "x": 18, "y": 3, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "redis_up{job=\"redis-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Podman exporter",
      "description": "The collector can scrape Podman container memory metrics.",
      "id": 6,
      "gridPos": { "x": 0, "y": 7, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"podman-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Node exporter",
      "description": "The collector can scrape host filesystem capacity metrics.",
      "id": 7,
      "gridPos": { "x": 6, "y": 7, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"node-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Kafka exporter",
      "description": "The collector can scrape Kafka cluster and consumer group metrics.",
      "id": 8,
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "up{job=\"kafka-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Kafka brokers",
      "description": "Current number of brokers visible to the exporter; this cluster currently expects one.",
      "id": 9,
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "kafka_brokers{job=\"kafka-exporter\"}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "row",
      "title": "PostgreSQL",
      "id": 10,
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Client connections",
      "description": "Current number of PostgreSQL client connections; shown as an exact count, not a percentage.",
      "id": 11,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum(pg_stat_activity_count{job=\"postgres-exporter\"})", "legendFormat": "connected clients" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Memory attributed by Podman to the data-postgres container; this is container-level usage, not PostgreSQL shared_buffers alone.",
      "id": 12,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "podman_container_mem_usage_bytes{job=\"podman-exporter\",name=\"data-postgres\"}", "legendFormat": "PostgreSQL container" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Redis",
      "id": 20,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Redis memory in use. The maxmemory line appears only when Redis has an explicit memory limit configured.",
      "id": 21,
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes{job=\"redis-exporter\"}", "legendFormat": "used" },
        { "refId": "B", "expr": "redis_memory_max_bytes{job=\"redis-exporter\"} > 0", "legendFormat": "maxmemory limit" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Client connections",
      "description": "Current number of connected Redis clients; shown as an exact count, not a percentage.",
      "id": 22,
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "redis_connected_clients{job=\"redis-exporter\"}", "legendFormat": "connected clients" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row",
      "title": "Kafka",
      "id": 30,
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Consumer group lag",
      "description": "Approximate committed-offset lag by consumer group and topic. Investigate sustained or steadily increasing lag rather than relying on one universal record threshold.",
      "id": 31,
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag_sum{job=\"kafka-exporter\",topic!~\"__.*\"})", "legendFormat": "{{consumergroup}} / {{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Consumer group members",
      "description": "Number of active members reported for each consumer group.",
      "id": 32,
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "kafka_consumergroup_members{job=\"kafka-exporter\"}", "legendFormat": "{{consumergroup}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "stat",
      "title": "Partition health",
      "description": "Counts under-replicated partitions and partitions without a leader. With the current single-broker, replication-factor-1 setup, replication health cannot demonstrate broker-failure tolerance.",
      "id": 33,
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "sum(kafka_topic_partition_under_replicated_partition{job=\"kafka-exporter\"}) or on() ((kafka_brokers{job=\"kafka-exporter\"} > 0) * 0)", "legendFormat": "under-replicated" },
        { "refId": "B", "expr": "count(kafka_topic_partition_leader{job=\"kafka-exporter\"} < 0) or on() ((kafka_brokers{job=\"kafka-exporter\"} > 0) * 0)", "legendFormat": "without leader" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "timeseries",
      "title": "Host root filesystem available",
      "description": "Free bytes on the host root filesystem. This represents Kafka data-volume capacity when the rootful Podman graph root is on /; adjust the mountpoint filter if Podman storage uses another filesystem.",
      "id": 34,
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\"}", "legendFormat": "available" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["infrastructure", "postgresql", "redis", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Data Stores & Kafka",
  "uid": "data-stores",
  "version": 3
}
