UPTIME_KUMA_PORT=3002

KUMA_USERNAME=admin
KUMA_PASSWORD=securepassword

# Keep these values in sync with data/.env for postgres-exporter.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=postgres

# Rootful Podman default. The Podman exporter needs access to this API socket;
# keep its service on the internal metrics network and do not publish its port.
# For rootless Podman, set this to the result of:
#   podman info --format '{{.Host.RemoteSocket.Path}}'
PODMAN_SOCKET_PATH=/run/podman/podman.sock

# Match the exporter major version to the Podman host:
#   v1.21.2 for Podman v5; v2.0.0 for Podman v6; <=v1.10.x for Podman v4.
PODMAN_EXPORTER_IMAGE=quay.io/navidys/prometheus-podman-exporter:v1.21.2
