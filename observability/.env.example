UPTIME_KUMA_PORT=3002

KUMA_USERNAME=admin
KUMA_PASSWORD=securepassword

# Keep these values in sync with data/.env for postgres-exporter.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=postgres

# Rootful Podman default. For rootless Podman, set this to the result of:
#   podman info --format '{{.Host.RemoteSocket.Path}}'
PODMAN_SOCKET_PATH=/run/podman/podman.sock
